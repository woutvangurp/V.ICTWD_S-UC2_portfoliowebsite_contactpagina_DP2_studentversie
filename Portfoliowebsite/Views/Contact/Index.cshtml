@{
    ViewData["Title"] = "Contact";
}

<h1>Contact</h1>

<form id="contactForm" asp-action="Index" method="post" novalidate>
    @Html.AntiForgeryToken()
    <div class="hp">
        <label for="website">website</label>
        <input type="text" id="website" name="website" value="" tabindex="-1"/>
    </div>
    <div>
        <label for="Name">Naam <span aria-label="verplicht" class="red">*</span></label>
        <input id="Name" name="Name" placeholder="Naam" aria-required="true" aria-invalid="false" aria-describedby="nameErr" />
        <div id="nameErr" class="error" role="alert" aria-live="polite"></div>
    </div>
    <div>
        <label for="Email">E-mail <span aria-label="verplicht" class="red">*</span></label>
        <input id="Email" name="Email" placeholder="naam@domein.nl" aria-required="true" aria-invalid="false" aria-describedby="emailErr" />
        <div id="emailErr" class="error" role="alert" aria-live="polite"></div>
    </div>
    <div>
        <label for="Subject">Onderwerp <span aria-label="verplicht" class="red">*</span></label>
        <input id="Subject" name="Subject" placeholder="Onderwerp" aria-required="true" aria-invalid="false" aria-describedby="sbjErr" />
        <div id="sbjErr" class="error" role="alert" aria-live="polite"></div>
    </div>
    <div>
        <label for="Message">Bericht <span aria-label="verplicht" class="red">*</span></label>
        <textarea id="Message" name="Message" rows="5" placeholder="Je bericht" aria-required="true" aria-invalid="false" aria-describedby="msgErr"></textarea>
        <div id="msgErr" class="error" role="alert" aria-live="polite"></div>
    </div>
    <div id="liveStatus" role="status" aria-live="polite">
        @if (TempData["StatusMessage"] != null)
        {
            <span class="error">@TempData["StatusMessage"]</span>
        }
    </div>
    <button class="send-button" id="send-button">
        Versturen
    </button>
</form>